# ---------------------------------------------------------------------------
# Nexo IT Website – Umgebungsvariablen
# Diese Datei nach ".env" kopieren und ausfuellen. ".env" niemals committen.
# ---------------------------------------------------------------------------

# Oeffentliche Basis-URL (ohne abschliessenden Slash). Wird fuer Canonical-URLs,
# sitemap.xml, robots.txt und Open-Graph-Tags verwendet.
SITE_URL=https://www.nexo-it.de

# Zufaelliger Schluessel (min. 32 Zeichen). Verschluesselt das SMTP-Passwort in
# der Datenbank (AES-256-GCM) und signiert Session- und CSRF-Token.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=BITTE_ERSETZEN_zufaelliger_string_mit_mindestens_32_zeichen

# Pfad zur SQLite-Datei. Der Ordner muss beschreibbar sein und darf NICHT
# oeffentlich per HTTP erreichbar sein.
DATABASE_PATH=./data/nexo.db

# Zugangsdaten fuer den ersten Admin-Login. Werden beim ersten Start einmalig
# in die Datenbank uebernommen (Passwort als bcrypt-Hash). Danach kann das
# Passwort im Admin geaendert werden; diese Variablen wirken dann nicht mehr.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=BITTE_AENDERN_MindestensZwoelfZeichen

# Optional: Reverse-Proxy. Auf "1" setzen, wenn die App hinter nginx/Traefik/
# Cloudflare laeuft, damit die Besucher-IP aus X-Forwarded-For gelesen wird.
TRUST_PROXY=0
